# Server-only Firebase Admin SDK service-account JSON for retention and export links.
# Set this as one JSON-valued Vercel secret; never expose it to the browser.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Vercel sends this value as: Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Defaults to true. Set exactly "false" only after a verified dry run in production.
INACTIVE_ACCOUNT_RETENTION_DRY_RUN=true
