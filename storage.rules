rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Hilfsfunktionen
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'olafheger@hs-results.com',
        'heger@hs-results.com',
        'olaf.heger@gmail.com',
        'olafheger@arcor.de'
      ];
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Homepage Bilder & Assets: Öffentlich lesbar, nur Admin schreibt
    match /homepage_assets/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Berater-Profilbilder sind öffentlich; CVs und sonstige Beraterdateien
    // sind nur für angemeldete Nutzer sichtbar. Die bestehenden Upload-Pfade
    // sind consultants/{name}/profile_image und consultants/{name}/cv_{datei}.
    match /consultants/{consultantId}/{fileName} {
      allow read: if fileName == 'profile_image' || isSignedIn();
      allow write: if isAdmin();
    }
    
    // Publikationen PDFs: Öffentlich lesbar, nur Admin schreibt
    match /publications/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Nutzer Uploads (Vault / Profile): Nur Besitzer oder Admin
    match /user_uploads/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
  }
}
