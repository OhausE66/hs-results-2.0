rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Hilfsfunktionen
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'olafheger@hs-results.com',
        'heger@hs-results.com',
        'olaf.heger@gmail.com',
        'olafheger@arcor.de'
      ];
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isImageUpload() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('^image/(jpeg|png|webp)$');
    }

    function isDocumentUpload() {
      return request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches('^(application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document|application/vnd.ms-excel|application/vnd.openxmlformats-officedocument.spreadsheetml.sheet|text/plain|text/csv|image/(jpeg|png|webp))$');
    }

    // Homepage Bilder & Assets: Öffentlich lesbar, nur Admin schreibt
    match /homepage_assets/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isImageUpload();
      allow delete: if isAdmin();
    }
    
    // Berater-Profilbilder sind öffentlich; CVs und sonstige Beraterdateien
    // sind nur für angemeldete Nutzer sichtbar. Die bestehenden Upload-Pfade
    // sind consultants/{name}/profile_image und consultants/{name}/cv_{datei}.
    match /consultants/{consultantId}/{fileName} {
      allow read: if fileName == 'profile_image' || isSignedIn();
      allow create, update: if isAdmin()
        && ((fileName == 'profile_image' && isImageUpload())
          || (fileName.matches('^cv_.*') && request.resource.size <= 20 * 1024 * 1024 && request.resource.contentType == 'application/pdf'));
      allow delete: if isAdmin();
    }
    
    // Publikationen PDFs: Öffentlich lesbar, nur Admin schreibt
    match /publications/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.size <= 20 * 1024 * 1024 && request.resource.contentType == 'application/pdf';
      allow delete: if isAdmin();
    }
    
    // Nutzer Uploads (Vault / Profile): Nur Besitzer oder Admin
    match /user_uploads/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if (isOwner(userId) || isAdmin()) && isDocumentUpload();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Profile images are personal data too and must never inherit public asset access.
    match /user_profiles/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if (isOwner(userId) || isAdmin()) && isImageUpload();
      allow delete: if isOwner(userId) || isAdmin();
    }
  }
}
